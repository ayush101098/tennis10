{
  "name": "trading-terminal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "start:all": "cd .. && source .venv/bin/activate && python sofa_proxy.py &>/dev/null & sleep 2 && cd trading-terminal && next dev --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.0",
    "next": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.11",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
