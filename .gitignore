# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# pytest
.pytest_cache/

# Database (large file - regenerate with data_pipeline.py)
tennis_data.db

# Generated images
calibration_*.png
backtesting_*.png

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Environment variables
.env
.env.local
# Timestamped .env backups — these carry the same live secrets as .env
.env.bak*
.env.*.bak

# Daemon pid files
*.pid

# tennis_vision generated run artifacts (regenerate: python -m tennis_vision.pipeline)
tennis_vision/out/

# Betfair SSL certificates (NEVER commit these)
certs/
*.crt
*.key
*.pem

# Trading logs
betfair_trading.log
logs/

# Node modules
node_modules/

# Next.js / trading-terminal build artifacts
trading-terminal/node_modules/
trading-terminal/.next/
trading-terminal/index_old.html

# Large data files
*.db
# SQLite WAL/shared-memory sidecars. `*.db` does not match these suffixes, so
# without them the point corpus commits its journal on every collector write.
*.db-wal
*.db-shm
*.db-journal
*.json
!netlify.toml
!package.json
!package-lock.json
!tsconfig.json
!vercel.json
!trading-terminal/public/rankings.json
!trading-terminal/public/nn_model.json
# Table-tennis deploy snapshot — shipped with the static export so the TT tab
# still has a pre-match board when the live push feed is down (tabletennis/push.py)
!trading-terminal/public/tt/*.json
# Match archive — the memory behind the programmatic pages. A static export
# builds only what exists at build time, so an un-committed archive means every
# past match page disappears on the next deploy.
!trading-terminal/data/matches/*.json
nohup.out

# Next.js build output
trading-terminal/out/
trading-terminal/next-env.d.ts
trading-terminal/tsconfig.tsbuildinfo

# Local Netlify folder
.netlify
