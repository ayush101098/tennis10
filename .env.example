# ============================================================================
# Betfair API Credentials
# ============================================================================
# Get these from https://developer.betfair.com/
#
# 1. Create a Betfair account at https://www.betfair.com
# 2. Go to https://developer.betfair.com/ → My Account → Manage App Keys
# 3. Create an Application Key (use "Delayed" for free, "Live" for prod)
# 4. Generate self-signed SSL certificates (see DEPLOYMENT_GUIDE_GCP.md)
#
BETFAIR_USERNAME=your_betfair_username
BETFAIR_PASSWORD=your_betfair_password
BETFAIR_APP_KEY=your_app_key_here
BETFAIR_CERT_PATH=/app/certs/client-2048.crt
BETFAIR_KEY_PATH=/app/certs/client-2048.key

# ============================================================================
# Trading Configuration
# ============================================================================
TRADING_DRY_RUN=true
TRADING_MAX_STAKE=25.0
TRADING_BANKROLL=5000.0

# ============================================================================
# Server Configuration
# ============================================================================
TRADING_SERVER_PORT=8888
API_SERVER_PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:8888

# ============================================================================
# Polymarket Execution (execution/pipeline.py)
# ============================================================================
# Required only for LIVE order placement (dry-run needs nothing).
# 1. POLYMARKET_PRIVATE_KEY: Polygon wallet private key that funds your bets.
#    If you signed up on polymarket.com (email/Magic wallet), export it from
#    your profile -> settings -> export private key.
# 2. POLYMARKET_PROXY_ADDRESS: the deposit/profile address Polymarket shows
#    for your account. Omit only if you trade straight from your own EOA.
# 3. Also set TRADING_DRY_RUN=false and pass --live to the pipeline.
# Live orders need: pip install py-clob-client
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=

# ── Endpoint / chain overrides (advanced) ───────────────────────────────────
# Defaults target Polymarket production (Polygon mainnet, chain 137).
# Polymarket does NOT run a public testnet with populated tennis markets, so a
# testnet host would return no events/order books and the agent would find
# nothing to trade. Override these only if you have a real alternate endpoint
# (self-hosted proxy, mock server, or a future testnet). Leave blank otherwise.
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_CHAIN_ID=137
# TRADING_HEDGE_DROP=0.15   # price drop on our side that triggers a full-lock hedge
# TRADING_LIVE_ONLY=true    # only enter bets on in-play matches (via gameStartTime); false = also pre-match
# TRADING_MARKET_FALLBACK=false  # also bet live matches the model can't price, backing the market favorite (NO real edge)
# TRADING_FALLBACK_EDGE=0.05     # assumed edge over the favorite's price in fallback mode
# TRADING_FALLBACK_MIN_FAV=0.55  # only fallback-bet when there's a clear favorite (price >= this)
# TRADING_REGEN_EVERY=15         # agent re-generates signals every N watch cycles (0 = never)

# ── SX Bet execution (execution/sxbet.py) — real money, sanctioned API ───────
# Reads (odds/markets) need nothing. Placing a bet (taker fill) needs a funded
# SX-Network wallet + its private key, and dry-run off. REHEARSE ON TESTNET FIRST:
# set SXBET_API=https://api.toronto.sx.bet and SXBET_CHAIN_ID from GET /metadata.
# SXBET_PRIVATE_KEY=            # signs EIP-712 fills; leave blank to stay read-only
# SXBET_WALLET_ADDRESS=         # your SX wallet (taker) address
# SXBET_API_KEY=                # X-Api-Key if your account requires it
# SXBET_API=https://api.sx.bet          # override to testnet for rehearsal
# SXBET_CHAIN_ID=4162                    # mainnet; testnet differs (see /metadata)
# A live SX post requires SXBET_PRIVATE_KEY set AND TRADING_DRY_RUN=false.
# TRADING_SX_AUTOBET=false   # agent auto-fires SX taker fills when a signal beats SX price
# TRADING_SX_MIN_EDGE=0.08   # min (our true_p - SX taker price) to auto-fire
#   ⚠ SX is a sharp live exchange; our signals are weaker, so a big "edge" usually
#   means our number is wrong, not SX. This auto-fire is -EV until the signal is
#   genuinely sharper than SX. Leave OFF unless you know why you're turning it on.

# ── SX three-tier strategies (execution/sx_strategies.py) ────────────────────
# GAME (spread/totals), SET (set winner, set spread, total sets) and MATCH
# (moneyline) markets, priced by the Monte-Carlo engine off live serve stats.
# Dry-run unless --arm AND TRADING_DRY_RUN=false AND SXBET_PRIVATE_KEY are all set.
# SX_MATCH_MIN_EDGE=0.04   # min edge on the moneyline (engine True P vs SX price)
# SX_SET_MIN_EDGE=0.06     # min edge on set markets (sim-priced → higher floor)
# SX_GAME_MIN_EDGE=0.06    # min edge on game spread / total games
# SX_MAX_EDGE=0.20         # above this = suspect inputs, skipped rather than bet
# SX_SIM_N=4000            # Monte-Carlo paths per fixture per scan

# ── Stripe card payments (trading-terminal) ──────────────────────────────────
# Set these in the NETLIFY site env (and .env.local for `next dev`).
# STRIPE_SECRET_KEY=sk_live_...      # or sk_test_... while testing
# STRIPE_WEBHOOK_SECRET=whsec_...    # from the webhook endpoint you create
# SITE_URL=https://tennispredictions.netlify.app   # optional; Netlify sets URL
#
# Webhook endpoint to add in the Stripe dashboard:
#   https://<your-site>/api/stripe/webhook
# Events: checkout.session.completed, invoice.paid, invoice.payment_failed
#
# Access is granted on return from Checkout by asking Stripe directly
# (/api/stripe/confirm), so a delayed webhook never leaves a payer locked out;
# the webhook keeps the roster current and handles monthly renewals.

# ── PayPal (international / US cards) ────────────────────────────────────────
# An Indian business can open a PayPal Business account with no approval wait,
# and US customers can pay BY CARD as a guest without a PayPal account.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=live               # or "sandbox" while testing

# ── Razorpay (India: UPI / netbanking / cards / wallets) ─────────────────────
# RAZORPAY_KEY_ID=rzp_live_...  # or rzp_test_... while testing
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=      # from Dashboard > Settings > Webhooks
# RAZORPAY_AMOUNT_INR=8900      # monthly price in rupees (~$100)
# USD_INR=89                    # only used to record USD revenue in the roster
#
# Razorpay webhook endpoint to add in the dashboard:
#   https://<your-site>/api/razorpay/webhook     event: payment.captured
# It exists for the case where the customer's browser dies after paying — the
# client-side verify call is the normal path.
#
# One-time payments granting 30 days, not subscriptions: RBI e-mandate rules
# make recurring card charges painful in India, and the entitlement model here
# is already "each payment grants 30 days".
